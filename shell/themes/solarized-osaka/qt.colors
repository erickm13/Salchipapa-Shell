# Qt (qtengine) y apps KDE (kdeglobals) con solarized, igual que el gtk.css del tema (como
# solarized-osaka.nvim): vistas = 001419, ventana/cabecera = 002c38, botones y tooltips = 063540,
# selección = Visual (063540), acento/foco = azul, enlaces = azul, negativo/neutro/positivo =
# rojo/amarillo/verde.
