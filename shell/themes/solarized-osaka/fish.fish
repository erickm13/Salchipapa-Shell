# Resaltado de fish con solarized, como solarized-osaka.nvim (tu colorscheme de nvim): comandos =
# Function (azul), palabras clave = Keyword (verde negrita), argumentos = @variable.parameter
# (naranja), cadenas = String (cian), símbolos = Operator (verde), $ = Special (naranja),
# comentarios = Comment (gris cursiva), selección = Visual, menú = Pmenu/PmenuSel.
# (La versión de fish que trae solarized-osaka pone los comandos en cian y los argumentos en violeta.)
set -g fish_color_normal b6c5c6
set -g fish_color_command 5aaefa --bold
set -g fish_color_keyword a2bb00 --bold
set -g fish_color_param fb724a
set -g fish_color_option fb724a
set -g fish_color_quote 34c5b9
set -g fish_color_redirection a2bb00
set -g fish_color_end a2bb00
set -g fish_color_operator fb724a
set -g fish_color_escape fb724a
set -g fish_color_error ff6c6a
set -g fish_color_comment 7b99a2 --italics
set -g fish_color_autosuggestion 7b99a2
set -g fish_color_valid_path --underline
set -g fish_color_selection --background=063540
set -g fish_color_search_match dba500 --background=063540
set -g fish_color_history_current --bold
set -g fish_color_cancel -r
set -g fish_pager_color_prefix fb724a --bold
set -g fish_pager_color_completion b6c5c6
set -g fish_pager_color_description 7b99a2 --italics
set -g fish_pager_color_progress 7b99a2
set -g fish_pager_color_selected_background --background=063540
set -g fish_pager_color_selected_completion b6c5c6 --bold
set -g fish_pager_color_selected_prefix fb724a --bold
set -g fish_pager_color_selected_description a0b4b6
