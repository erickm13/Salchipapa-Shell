				<key>popupCss</key>
				<string>
            html {
              background-color: #1b1b1b;
              color: #fbf1c7;
              padding: 12px;
            }

            a {
              color: #8ec07c;
            }

            .error, .deleted {
              color: #fb4934;
            }

            .success, .inserted, .name {
              color: #b8bb26;
            }

            .warning, .modified {
              color: #fabd2f;
            }

            .type {
              color: #fabd2f;
              font-style: italic;
            }

            .param {
              color: #fbf1c7;
            }

            .current {
              text-decoration: underline;
            }
          </string>
