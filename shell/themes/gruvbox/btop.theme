# btop con gruvbox (morhetz/gruvbox), repartido como gruvbox.nvim: fila seleccionada = CursorLine
# (bg1) con el amarillo de CursorLineNr, cajas y separadores = WinSeparator (bg3), atajos = naranja
# (Special), gráficas de verde (bien) a amarillo y rojo (al límite).
# apply-colors.sh lo copia a ~/.config/btop/themes/salchipapa.theme (btop lo lee al abrirse).

# Fondo (solo si theme_background = true en btop.conf; tú lo tienes transparente)
theme[main_bg]="#282828"
theme[main_fg]="#ebdbb2"
theme[title]="#ebdbb2"
# Letras de los atajos en los títulos de las cajas
theme[hi_fg]="#fe8019"
theme[selected_bg]="#3c3836"
theme[selected_fg]="#fabd2f"
theme[inactive_fg]="#665c54"
theme[graph_text]="#a89984"
theme[meter_bg]="#3c3836"
theme[proc_misc]="#b8bb26"

# Cajas y separadores
theme[cpu_box]="#665c54"
theme[mem_box]="#665c54"
theme[net_box]="#665c54"
theme[proc_box]="#665c54"
theme[div_line]="#504945"

# Gráficas: verde -> amarillo -> rojo
theme[temp_start]="#b8bb26"
theme[temp_mid]="#fabd2f"
theme[temp_end]="#fb4934"
theme[cpu_start]="#b8bb26"
theme[cpu_mid]="#fabd2f"
theme[cpu_end]="#fb4934"
theme[used_start]="#b8bb26"
theme[used_mid]="#fabd2f"
theme[used_end]="#fb4934"
theme[process_start]="#8ec07c"
theme[process_mid]="#fabd2f"
theme[process_end]="#fb4934"
# Memoria libre/disponible: al revés (poca = rojo)
theme[free_start]="#fb4934"
theme[free_mid]="#fabd2f"
theme[free_end]="#b8bb26"
theme[available_start]="#fb4934"
theme[available_mid]="#fabd2f"
theme[available_end]="#b8bb26"
theme[cached_start]="#458588"
theme[cached_mid]="#83a598"
theme[cached_end]="#8ec07c"
# Red: bajada en verdes, subida en naranjas
theme[download_start]="#98971a"
theme[download_mid]="#b8bb26"
theme[download_end]="#8ec07c"
theme[upload_start]="#d79921"
theme[upload_mid]="#fe8019"
theme[upload_end]="#fb4934"
