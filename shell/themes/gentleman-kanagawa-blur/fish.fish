# Resaltado de fish con Gentleman Kanagawa Blur, como su colorscheme de nvim: comandos = Function
# (morado), palabras clave = Keyword (lila), argumentos = @variable.parameter, cadenas = String
# (dorado), símbolos = Operator, $ = @punctuation.special, comentarios = Comment (cursiva),
# selección = Visual, búsqueda = Search. (Su versión de fish pone los comandos en cian.)
set -g fish_color_normal f3f6f9
set -g fish_color_command b99bf2 --bold
set -g fish_color_keyword c99ad6
set -g fish_color_param c7a8df
set -g fish_color_option c7a8df
set -g fish_color_quote dfbd76
set -g fish_color_redirection deba87
set -g fish_color_end deba87
set -g fish_color_operator 96a2b0
set -g fish_color_escape e6a9c2
set -g fish_color_error c4746e
set -g fish_color_comment 8394a3 --italics
set -g fish_color_autosuggestion 5c6170
set -g fish_color_valid_path --underline
set -g fish_color_selection --background=232a36
set -g fish_color_search_match e0c15a --background=232a36
set -g fish_color_history_current --bold
set -g fish_color_cancel -r
set -g fish_pager_color_prefix e0c15a --bold
set -g fish_pager_color_completion f3f6f9
set -g fish_pager_color_description 8394a3 --italics
set -g fish_pager_color_progress 8394a3
set -g fish_pager_color_selected_background --background=232a36
set -g fish_pager_color_selected_completion f3f6f9 --bold
set -g fish_pager_color_selected_prefix e0c15a --bold
set -g fish_pager_color_selected_description a3b5c1
