#!/usr/bin/env fish

set device "asuf1416:00-2808:0108-touchpad"
set state_file /tmp/touchpad-enabled

if test -f $state_file
    hyprctl keyword "device[$device]:enabled" false
    rm $state_file
    notify-send "Touchpad" "Desactivado" --icon=input-touchpad-symbolic -t 2000
else
    hyprctl keyword "device[$device]:enabled" true
    touch $state_file
    notify-send "Touchpad" "Activado" --icon=input-touchpad-symbolic -t 2000
end
