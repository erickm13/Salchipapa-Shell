#!/usr/bin/env python3
import sys, re

if len(sys.argv) < 2:
    print("Usage: sddm-theme-apply <theme-name>")
    sys.exit(1)

theme = sys.argv[1]
conf = "/etc/sddm.conf.d/theme.conf"

with open(conf) as f:
    content = f.read()

if re.search(r'(?m)^Current=', content):
    content = re.sub(r'(?m)^Current=.*$', f'Current={theme}', content)
else:
    content = re.sub(r'(?m)^\[Theme\]', f'[Theme]\nCurrent={theme}', content)

with open(conf, "w") as f:
    f.write(content)

print(f"SDDM theme: {theme}")
