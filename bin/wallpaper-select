#!/usr/bin/env fish

set STEAM_WE "$HOME/.local/share/Steam/steamapps/workshop/content/431960"

# Build list: "ID — Title"
set entries
for id in (ls $STEAM_WE)
    set title (python3 -c "import sys,json; d=json.load(open('$STEAM_WE/$id/project.json')); print(d.get('title','?'))" 2>/dev/null)
    if test -n "$title"
        set entries $entries "$id — $title"
    end
end

set selected (printf '%s\n' $entries | fzf \
    --prompt="Wallpaper: " \
    --preview='set id (echo {} | cut -d" " -f1); chafa --size=80x40 "'$STEAM_WE'/$id/preview.jpg" 2>/dev/null || echo "Sin preview"' \
    --preview-window=right:50%)

if test -z "$selected"
    echo "Cancelado"
    exit 0
end

set id (echo $selected | cut -d' ' -f1)

pkill -f linux-wallpaperengine 2>/dev/null
sleep 0.3

nohup linux-wallpaperengine --screen-root HDMI-A-1 --bg $id --fps 60 --silent >/dev/null 2>&1 &
disown
echo "Aplicando: $selected"
sleep 1
