#!/usr/bin/env fish

set monitor $argv[1]
if test -z "$monitor"
    echo "Usage: set-primary-monitor MONITOR_NAME"
    exit 1
end

# Move workspace 1 to selected monitor
hyprctl dispatch moveworkspacetomonitor 1 $monitor

# Build excludedScreens: all monitors except the selected one
set all_monitors (hyprctl monitors -j | jq -r '.[].name')
set excluded_json "["
set first true
for m in $all_monitors
    if test "$m" != "$monitor"
        if test "$first" = "true"
            set excluded_json "$excluded_json\"$m\""
            set first false
        else
            set excluded_json "$excluded_json,\"$m\""
        end
    end
end
set excluded_json "$excluded_json]"

# Update shell.json
set config ~/.config/caelestia/shell.json
jq --argjson exc "$excluded_json" '.bar.excludedScreens = $exc' $config > /tmp/caelestia-primary-tmp.json \
    && mv /tmp/caelestia-primary-tmp.json $config

