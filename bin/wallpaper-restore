#!/usr/bin/env fish

set data ~/.local/share/wallpaper-picker/current.json

if test -f ~/.local/share/wallpaper-picker/no-autostart
    exit 0
end

if not test -f $data
    exit 0
end

set wp_id (python3 -c "import json; d=json.load(open('$data')); print(d.get('id',''))" 2>/dev/null)
set screens (python3 -c "import json; d=json.load(open('$data')); print('\n'.join(d.get('screens',[])))" 2>/dev/null)

if test -z "$wp_id"
    exit 0
end

set args prime-run linux-wallpaperengine --fps 165 --silent --no-audio-processing --fullscreen-pause-only-active
for screen in $screens
    set args $args --screen-root $screen --bg $wp_id
end

exec $args
